{
  "name": "carddex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:local": "wrangler d1 migrations apply carddex-preview --local --persist-to .wrangler/preview-state",
    "dev": "npm run build && npm run db:local && wrangler dev --ip 127.0.0.1 --port 8787 --persist-to .wrangler/preview-state",
    "dev:test": "node scripts/test-server.mjs",
    "catalogue:prepare": "python3 scripts/prepare_catalogue.py",
    "catalogue:audit": "npm run catalogue:prepare && node scripts/import-catalogue.mjs --audit",
    "sets:prepare": "node scripts/sync-sets.mjs",
    "sets:local": "node scripts/sync-sets.mjs --apply",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js && playwright test",
    "access:plan": "node scripts/setup-access.mjs",
    "access:apply": "node scripts/setup-access.mjs --apply",
    "sharing:plan": "node scripts/setup-sharing-access.mjs",
    "sharing:apply": "node scripts/setup-sharing-access.mjs --apply",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "wrangler": "4.156.0"
  }
}
