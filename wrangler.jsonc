{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carddex-preview",
  "account_id": "de7f1e314a126dcd3e39c30dfe25f58b",
  "main": "src/worker.js",
  "workers_dev": true,
  "routes": [{ "pattern": "collect.postwork.tech", "custom_domain": true }],
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/sprites/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carddex-preview",
      "database_id": "6e6f06ec-b6cd-4319-b933-a3c77d517075",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PASSKEY_ORIGIN": "https://collect.postwork.tech",
    "PASSKEY_LEGACY_ORIGIN": "https://carddex-preview.pohon.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": false
}
